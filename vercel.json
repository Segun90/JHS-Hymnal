{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/privacy", "destination": "/docs/index.html" },
    { "source": "/privacy-policy", "destination": "/docs/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=UTF-8"
        }
      ]
    }
  ]
}
