{
  "expo": {
    "name": "J.H.S Bible & Hymnal",
    "slug": "jhs-bible-hymnal",
    "owner": "segun90",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "jhs",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.jhs.biblehymnal"
    },
    "android": {
      "package": "org.jhs.biblehymnal",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E3A8A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/Sounds/act.mp3",
            "./assets/Sounds/pray.mp3",
            "./assets/Sounds/read.mp3",
            "./assets/Sounds/wake.mp3"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1132684d-ae87-456f-9374-83e2c93208fa"
      }
    }
  }
}
